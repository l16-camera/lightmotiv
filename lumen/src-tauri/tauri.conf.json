{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Luminat",
	"version": "2026.8.10",
	"identifier": "dev.blmk.luminat",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Luminat — 16 witness, 1 emerges · isamarin × BLMK",
				"width": 1280,
				"height": 840,
				"minWidth": 960,
				"minHeight": 640,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": false,
		"targets": ["app", "dmg"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "12.0"
		},
		"longDescription": "Use make package-macos for a shippable Luminat.app (embeds libcp-export)."
	}
}